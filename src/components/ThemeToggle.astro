---
type Props = {
	class?: string;
};

const { class: className = '' } = Astro.props as Props;
---

<button type="button" class={`theme-toggle relative cursor-pointer p-2 ${className}`}>
	<svg
		class="theme-icon icon-system"
		width="16"
		height="16"
		viewBox="0 0 16 16"
		fill="none"
		stroke-width="1.5"
		xmlns="http://www.w3.org/2000/svg"
	>
		<rect class="stroke-yellow-500" x="0.75" y="2.25" width="14.5" height="9.5" rx="1.5"></rect>
		<path class="stroke-yellow-500" stroke-linecap="round" d="M5.5 14.5h5M8 11.75v2.75"></path>
	</svg>
	<svg class="theme-icon icon-light" width="16" height="16" xmlns="http://www.w3.org/2000/svg">
		<path
			class="fill-yellow-500"
			d="M7 0h2v2H7zM12.88 1.637l1.414 1.415-1.415 1.413-1.413-1.414zM14 7h2v2h-2zM12.95 14.433l-1.414-1.413 1.413-1.415 1.415 1.414zM7 14h2v2H7zM2.98 14.364l-1.413-1.415 1.414-1.414 1.414 1.415zM0 7h2v2H0zM3.05 1.706 4.463 3.12 3.05 4.535 1.636 3.12z"
		></path>
		<path class="fill-yellow-500" d="M8 4C5.8 4 4 5.8 4 8s1.8 4 4 4 4-1.8 4-4-1.8-4-4-4Z"></path>
	</svg>
	<svg class="theme-icon icon-dark" width="16" height="16" xmlns="http://www.w3.org/2000/svg">
		<path
			class="fill-yellow-500"
			d="M6.2 1C3.2 1.8 1 4.6 1 7.9 1 11.8 4.2 15 8.1 15c3.3 0 6-2.2 6.9-5.2C9.7 11.2 4.8 6.3 6.2 1Z"
		></path>
		<path
			class="fill-yellow-500"
			d="M12.5 5a.625.625 0 0 1-.625-.625 1.252 1.252 0 0 0-1.25-1.25.625.625 0 1 1 0-1.25 1.252 1.252 0 0 0 1.25-1.25.625.625 0 1 1 1.25 0c.001.69.56 1.249 1.25 1.25a.625.625 0 1 1 0 1.25c-.69.001-1.249.56-1.25 1.25A.625.625 0 0 1 12.5 5Z"
		></path>
	</svg>
	<span class="theme-toggle-label sr-only">Theme</span>
</button>

<style>
	.theme-icon {
		display: none;
	}

	:global(html[data-theme-mode='system']) .icon-system,
	:global(html[data-theme-mode='light']) .icon-light,
	:global(html[data-theme-mode='dark']) .icon-dark {
		display: block;
	}
</style>

<script>
	type ThemeMode = 'system' | 'light' | 'dark';

	const NEXT_MODE: Record<ThemeMode, ThemeMode> = {
		system: 'light',
		light: 'dark',
		dark: 'system'
	};
	const LABELS: Record<ThemeMode, string> = {
		system: 'Theme: system. Switch to light',
		light: 'Theme: light. Switch to dark',
		dark: 'Theme: dark. Switch to system'
	};

	const root = document.documentElement;
	const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');

	function readMode(): ThemeMode {
		const stored = localStorage.getItem('theme');
		return stored === 'light' || stored === 'dark' ? stored : 'system';
	}

	function applyMode(mode: ThemeMode) {
		root.dataset.themeMode = mode;
		root.classList.toggle('dark', mode === 'dark' || (mode === 'system' && prefersDark.matches));

		document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((toggle) => {
			toggle.setAttribute('aria-label', LABELS[mode]);
			const label = toggle.querySelector('.theme-toggle-label');
			if (label) label.textContent = LABELS[mode];
		});
	}

	applyMode(readMode());

	document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((toggle) => {
		toggle.addEventListener('click', () => {
			const next = NEXT_MODE[readMode()];

			if (next === 'system') {
				localStorage.removeItem('theme');
			} else {
				localStorage.setItem('theme', next);
			}

			applyMode(next);
		});
	});

	// Follow the OS while in system mode
	prefersDark.addEventListener('change', () => {
		if (readMode() === 'system') applyMode('system');
	});
</script>
